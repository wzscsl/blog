{{- $pages := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $pages = $pages | append (dict "title" .Title "url" .RelPermalink "content" (.Plain | htmlUnescape) "description" (.Description | default (.Summary | plainify)) "tags" (.Params.tags | default slice) "categories" (.Params.categories | default slice) "series" (.Params.series | default slice) "date" (.Date.Format "2006.01.02")) -}}
{{- end -}}
{{- $pages | jsonify -}}
